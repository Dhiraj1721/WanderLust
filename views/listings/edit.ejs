<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>

<body>
    <h3>Edit Hotel</h3>
    <form action="/listings/<%=singleList.id %>?_method=put" method="post">
        <label>Add Title</label>
        <input type="text" name="listing[title]" value="<%=singleList.title %>">
        <br><br> <label>Add Description</label>
        <textarea name="listing[description]"><%=singleList.description %></textarea>
        <br><br><label>Add Image link</label>
        <input type="text" name="listing[image]" value="<%=singleList.image %>">
        <br><br><label>Add price</label>
        <input type="number" name="listing[price]" value="<%=singleList.price %>">
        <br><br><label>Add Location</label>
        <input type="text" name="listing[location]" value="<%=singleList.location %>">
        <br><br><label>Add Country</label>
        <input type="text" name="listing[country]" value="<%=singleList.country %>">
        <br><br>
        <button>Edit</button>
    </form>
</body>

</html>