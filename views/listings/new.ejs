<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>

<body>
    <h3>Add New Hotel</h3>
    <form action="/listings" method="post">
        <!-- <label>Add Title</label> -->
        <input type="text" name="listing[title]" placeholder="Add title details">
        <br><br>
        <!-- <label>Add Description</label> -->
        <textarea name="listing[description]" placeholder="Add description"></textarea>
        <br><br>
        <!-- <label>Add Add Image link</label> -->
        <input type="text" name="listing[image]" placeholder="Add imagae">
        <br><br>
        <!-- <label>Add price</label> -->
        <input type="number" name="listing[price]" placeholder="Add Price">
        <br><br>
        <!-- <label>Add Location</label> -->
        <input type="text" name="listing[location]" placeholder="Add Location">
        <br><br>
        <!-- <label>Add Country</label> -->
        <input type="text" name="listing[country]" placeholder="Add Country">
        <br><br>
        <button>Add</button>
    </form>
</body>

</html>