<%- layout('/layouts/boilerPlate.ejs') %>

  <body>
    <h3>Individual Listing of Avaliable hotel</h3>
    <h4>id of current list: <%= singleList.id %>
    </h4>
    <div class="list">
      <ul>
        <li>
          Hotel Name: <%= singleList.title %>
        </li>
        <li>Description: <%= singleList.description %>
        </li>
        <li>
          Price: &#8377; <%= singleList.price.toLocaleString("en-IN") %>
        </li>
        <li>
          Location: <%= singleList.location %>
        </li>
        <li>
          country: <%= singleList.country %>
        </li>
      </ul>

      <a href="/listings/<%= singleList.id %>/edit">Edit Listing</a>

      <form method="post" action="/listings/<%= singleList.id %>?_method=delete"><button>Delete this listing</button>
      </form>
    </div>
  </body>