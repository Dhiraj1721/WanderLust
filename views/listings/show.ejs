<%- layout('/layouts/boilerPlate.ejs') %>

  <body>
    <div class="row mt-3">
      <div class="col-8 offset-3">
        <h3>Listing Details</h3>
      </div>
      <div class="card col-6 offset-3">
        <img src="<%= singleList.image %>" class="card-img-top show-img" alt="listing-image">
        <div class="card-body">
          <p class="card-text">
            <b>
              <%= singleList.title %>
            </b><br>
            <%= singleList.description %> <br>
              Price: &#8377; <%= singleList.price.toLocaleString("en-IN") %> <br>
                <%= singleList.location %> <br>
                  <%= singleList.country %>
          </p>
        </div>
      </div>
      <div class="show-btn">
        <a href="/listings/<%= singleList.id %>/edit" class="btn btn-dark edit-btn  col-1 offset-3">Edit</a>

        <form method="post" action="/listings/<%= singleList.id %>?_method=delete"><button
            class="btn btn-dark offset-5">Delete</button>
        </form>
      </div>
    </div>
  </body>